diff --git a/tests/auth/test_middleware.py b/tests/auth/test_middleware.py
index 7d8e9f0..1a2b3c4 100644
--- a/tests/auth/test_middleware.py
+++ b/tests/auth/test_middleware.py
@@ -30,3 +30,25 @@ def test_session_cookie_sets_user(client, session_cookie):
     resp = client.get("/api/me", headers={"Cookie": session_cookie})
     assert resp.status_code == 200
+
+
+def test_bearer_token_sets_user(client, api_token):
+    resp = client.get("/api/me", headers={"Authorization": f"Bearer {api_token.raw}"})
+    assert resp.status_code == 200
+    assert resp.json["auth_source"] == "token"
+
+
+def test_revoked_token_is_anonymous(client, revoked_token):
+    resp = client.get("/api/me", headers={"Authorization": f"Bearer {revoked_token.raw}"})
+    assert resp.status_code == 401
+
+
+def test_require_role_rejects_anonymous(client):
+    resp = client.get("/api/admin/users")
+    assert resp.status_code == 401
+
+
+def test_require_role_no_admin_fallthrough(client, admin_session):
+    # admins used to bypass role checks; now they need the role explicitly
+    resp = client.get("/api/billing/reports", headers={"Cookie": admin_session})
+    assert resp.status_code == 403
