+def _principal_from_token(header: str | None) -> User | None:
+    if not header or not header.startswith("Bearer "):
+        return None
+    raw = header.removeprefix("Bearer ").strip()
+    prefix, _, secret = raw.partition(".")
+    token = db.session.query(ApiToken).filter_by(prefix=prefix, revoked_at=None).one_or_none()
+    if token is None or not check_password_hash(token.secret_hash, secret):
+        return None
+    return token.owner
+
+
+def resolve_principal() -> None:
+    """Populate g.user from a cookie session or a bearer token, in that order."""
+    sess = load_session(request.cookies.get("sid"))
+    if sess is not None:
+        g.user = sess.user
+        g.auth_source = "session"
+        return
+    user = _principal_from_token(request.headers.get("Authorization"))
+    if user is not None:
+        g.user = user
+        g.auth_source = "token"
+        return
+    g.user = AnonymousUser()
+    g.auth_source = None
 
 
