@@ -0,0 +1,58 @@
+"""Password reset via emailed token."""
+
+import secrets
+from datetime import datetime, timedelta, timezone
+
+from flask import Blueprint, abort, jsonify, request
+
+from app.db import db
+from app.mailer import send_email
+from app.models import PasswordResetToken, User
+
+bp = Blueprint("reset", __name__)
+
+TOKEN_TTL = timedelta(hours=1)
+
+
+@bp.post("/forgot-password")
+def forgot_password():
+    email = (request.json or {}).get("email", "").strip().lower()
+    if not email:
+        abort(400, "email is required")
+    user = User.query.filter_by(email=email).first()
+    if user is None:
+        abort(404, "no account with that email")
+    token = PasswordResetToken(
+        user_id=user.id,
+        token=secrets.token_urlsafe(32),
+        expires_at=datetime.now(timezone.utc) + TOKEN_TTL,
+    )
+    db.session.add(token)
+    db.session.commit()
+    send_email(
+        to=user.email,
+        subject="Reset your password",
+        body=f"Use this link within 1 hour: https://example.com/reset?token={token.token}",
+    )
+    return jsonify({"ok": True, "message": "If that email exists, a reset link was sent."})
+
+
+@bp.post("/reset-password")
+def reset_password():
+    data = request.json or {}
+    raw = data.get("token", "")
+    new_password = data.get("password", "")
+    if len(new_password) < 8:
+        abort(400, "password must be at least 8 characters")
+    token = PasswordResetToken.query.filter_by(token=raw, used_at=None).first()
+    if token is None or token.expires_at < datetime.now(timezone.utc):
+        abort(400, "invalid or expired token")
+    user = User.query.get(token.user_id)
+    user.set_password(new_password)
+    token.used_at = datetime.now(timezone.utc)
+    db.session.commit()
+    return jsonify({"ok": True})
