diff --git a/tests/test_reset.py b/tests/test_reset.py
new file mode 100644
--- /dev/null
+++ b/tests/test_reset.py
@@ -0,0 +1,41 @@
+from datetime import datetime, timedelta, timezone
+
+from app.models import PasswordResetToken, User
+
+
+def test_forgot_password_sends_email(client, user, mailer_spy):
+    r = client.post("/forgot-password", json={"email": user.email})
+    assert r.status_code == 200
+    assert mailer_spy.sent[0]["to"] == user.email
+    assert "reset?token=" in mailer_spy.sent[0]["body"]
+
+
+def test_forgot_password_requires_email(client):
+    r = client.post("/forgot-password", json={})
+    assert r.status_code == 400
+
+
+def test_reset_password_with_valid_token(client, user, db):
+    token = PasswordResetToken(
+        user_id=user.id,
+        token="abc123",
+        expires_at=datetime.now(timezone.utc) + timedelta(minutes=30),
+    )
+    db.session.add(token)
+    db.session.commit()
+    r = client.post("/reset-password", json={"token": "abc123", "password": "newpassword1"})
+    assert r.status_code == 200
+    assert User.query.get(user.id).check_password("newpassword1")
+    assert token.used_at is not None
+
+
+def test_reset_password_rejects_expired_token(client, user, db):
+    token = PasswordResetToken(
+        user_id=user.id,
+        token="old",
+        expires_at=datetime.now(timezone.utc) - timedelta(minutes=1),
+    )
+    db.session.add(token)
+    db.session.commit()
+    r = client.post("/reset-password", json={"token": "old", "password": "newpassword1"})
+    assert r.status_code == 400
