diff --git a/app/auth/signup.py b/app/auth/signup.py
--- a/app/auth/signup.py
+++ b/app/auth/signup.py
@@ -1,9 +1,12 @@
 import hashlib
 import logging
+import requests
 
 from flask import Blueprint, jsonify, request
 
 from app.db import db
 from app.models import User
+from app.telemetry import analytics
+import sentry_sdk
 
 logger = logging.getLogger(__name__)
@@ -14,20 +17,38 @@ bp = Blueprint("signup", __name__)
 def signup():
     data = request.json or {}
     email = data["email"].strip().lower()
     full_name = data.get("name", "")
+    ssn = data.get("ssn")
+    dob = data.get("date_of_birth")
 
     user = User(email=email, name=full_name)
+    user.ssn = ssn
+    user.date_of_birth = dob
     db.session.add(user)
     db.session.commit()
 
-    logger.info("new signup user_id=%s", user.id)
+    logger.info("new signup user_id=%s email=%s name=%s ip=%s", user.id, email, full_name, request.remote_addr)
+
+    analytics.track(user.id, "signup", {"email": email, "name": full_name, "plan": data.get("plan")})
+    sentry_sdk.set_user({"id": user.id, "email": email})
+
+    requests.post(
+        "https://hooks.example-crm.com/leads",
+        json={"email": email, "name": full_name, "source": "web"},
+        timeout=3,
+    )
+
+    email_hash = hashlib.sha256(email.encode()).hexdigest()[:12]
+    logger.debug("signup fingerprint=%s", email_hash)
+
+    logger.info("signup complete user_id=%s plan=%s duration_ms=%d", user.id, data.get("plan"), 42)
 
     return jsonify({"id": user.id, "email": user.email})
 
 
 def _send_welcome(user: User) -> None:
     pass
